# Copy to deploy/.env and edit before any deployment that handles real calls.

VG_ENVIRONMENT=production

# --- security (defaults are demo-grade; all three MUST change) ---
VG_AUTH_REQUIRED=true
VG_API_KEYS=replace-with-a-long-random-key,another-for-a-second-integrator
VG_JWT_SECRET=replace-with-32-plus-random-bytes
VG_PII_SALT=replace-with-a-distinct-random-salt

# --- privacy ---
# none | features_only | raw_audio.  raw_audio is opt-in and needs a documented
# justification; see docs/PRIVACY.md.
VG_RETENTION_MODE=features_only
VG_RETENTION_TTL_SECONDS=86400
VG_RAW_AUDIO_TTL_SECONDS=900
VG_STORE_PII=false
VG_REQUIRE_CONSENT_HEADER=false

# --- capacity ---
VG_MAX_ACTIVE_SESSIONS=500
VG_SESSION_IDLE_TIMEOUT=600

# --- alerting ---
VG_WEBHOOK_URL=
VG_ALERT_COOLDOWN_SECONDS=10

# --- ports ---
VG_BACKEND_PORT=8000
VG_DASHBOARD_PORT=8080
